#!/bin/bash
# run_in_container IDX|auto|none [-w WAIT_S] -- CMD...
#   run CMD (bash -c) in rocm/pytorch on the gfx1201 dev box.
#
# The one way GPU work runs on that box, for a person and for CI (scripts/ci/run_gfx1201.sh):
# - IDX: the host's rocm-smi index of the one GPU the container sees (as HIP device 0), taken under
#   our lock of the card (gpulock.sh) and only when no other process holds it. The box is shared and
#   nobody else uses our locks, so the idle check is what keeps us off everyone else's work.
#   `auto`: the first card of $HK_GPUS_PREF (default "3 2 1 4 5 6 7"; card 0 is left out of
#   the default) that is unlocked and idle, waiting up to WAIT_S (default 3600)
#   for one. `none`: no GPU, for builds and the no-GPU tiers.
# - Core dumps are off three ways (--ulimit core=0, ulimit -c 0, HSA_DISABLE_COREDUMP_ON_EXCEPTION):
#   a killed GPU process can write 100+ GB to the shared root partition.
# - Mounts: $HK_CTR_ROOT (required unless HK_CTR_MOUNTS is set: the directory our work lives in on the
#   box) at /w, the working directory; HK_CTR_MOUNTS replaces that with its own docker -v/-w
#   arguments (CI's /ci layout).
# Environment: HK_IMAGE (default rocm/pytorch rocm7.2.3 py3.12, the gfx950 CI's image), HK_CTR_NAME
# (the container's name), HK_CTR_GPU_FILE (where `auto` writes the index it took), HK_CTR_DOCKER_ARGS
# (more `docker run` arguments: CI's labels), HK_CTR_LOCK_HELD=1 (the caller holds card IDX's lock
# already and keeps it until the container is gone: run_gfx1201.sh), HK_ALLOW_SHARED=1 (run on a
# card someone else holds; for debugging only), HK_CTR_AS_ROOT=1 (root in the container, HOME=/tmp: the
# install matrix's pip into the image's own Python; only with read-only mounts).
set -u
. "$(dirname "$(readlink -f "$0")")/gpulock.sh"
ME=${0##*/}
IDX=${1:?usage: $ME IDX|auto|none [-w WAIT_S] -- CMD...}; shift
WAIT=3600
[ "${1:-}" = -w ] && { WAIT=$2; shift 2; }
[ "${1:-}" = -- ] && shift
[ $# -gt 0 ] || { echo "usage: $ME IDX|auto|none [-w WAIT_S] -- CMD..." >&2; exit 2; }
IMAGE=${HK_IMAGE:-rocm/pytorch:rocm7.2.3_ubuntu24.04_py3.12_pytorch_release_2.10.0}
ROOT=${HK_CTR_ROOT:-}
[ -n "$ROOT" ] || [ -n "${HK_CTR_MOUNTS:-}" ] || { echo "$ME: set HK_CTR_ROOT (or HK_CTR_MOUNTS)" >&2; exit 2; }
WHAT="$ME $*"

# Take card $1 if it is idle: our lock (fd 9) and nobody's KFD state on it.
take() {
    [ -z "$(gpu_foreign "$1")" ] || return 1
    GPULOCK_WHAT="$WHAT" gpulock_take "$1" 0 2>/dev/null || return 1
    [ -z "$(gpu_foreign "$1")" ] || { exec 9>&-; return 1; }
}

if [ "$IDX" = auto ]; then
    t0=$(date +%s)
    while :; do
        for g in ${HK_GPUS_PREF:-3 2 1 4 5 6 7}; do take "$g" && { IDX=$g; break; }; done
        [ "$IDX" != auto ] && break
        [ $(( $(date +%s) - t0 )) -ge "$WAIT" ] && {
            echo "$ME: no idle GPU among ${HK_GPUS_PREF:-3 2 1 4 5 6 7} for ${WAIT}s" >&2; exit 6; }
        sleep 60
    done
    echo "$ME: GPU $IDX" >&2
elif [ "$IDX" != none ]; then
    [ "${HK_CTR_LOCK_HELD:-0}" = 1 ] || GPULOCK_WHAT="$WHAT" gpulock_take "$IDX" "$WAIT" || exit $?
    f=$(gpu_foreign "$IDX")
    if [ -n "$f" ] && [ "${HK_ALLOW_SHARED:-0}" != 1 ]; then
        echo "$ME: GPU $IDX is in use by another process; not running (HK_ALLOW_SHARED=1 to override):" >&2
        echo "$f" >&2
        exit 6
    fi
fi
DEV=()
if [ "$IDX" != none ]; then
    [ -n "${HK_CTR_GPU_FILE:-}" ] && echo "$IDX" > "$HK_CTR_GPU_FILE"
    R=/dev/dri/$(gpulock_render "$IDX")
    DEV=(--device /dev/kfd --device "$R" --group-add "$(stat -c %g /dev/kfd)" --group-add "$(stat -c %g "$R")")
fi
if [ -n "${HK_CTR_MOUNTS:-}" ]; then read -ra MOUNTS <<< "$HK_CTR_MOUNTS"; else MOUNTS=(-v "$ROOT:/w" -w /w); fi
read -ra EXTRA <<< "${HK_CTR_DOCKER_ARGS:-}"
WHO=(--user "$(id -u):$(id -g)" -e HOME=/w/home)
[ "${HK_CTR_AS_ROOT:-0}" = 1 ] && WHO=(-e HOME=/tmp)
exec docker run --rm -i --name "${HK_CTR_NAME:-hk-ctr-$(date +%s)-$$}" "${EXTRA[@]}" \
    --ulimit core=0 -e HSA_DISABLE_COREDUMP_ON_EXCEPTION=1 \
    "${WHO[@]}" -e USER="$(id -un)" "${DEV[@]}" --ipc=host \
    --security-opt seccomp=unconfined "${MOUNTS[@]}" --entrypoint bash "$IMAGE" -c "ulimit -c 0; $*"
